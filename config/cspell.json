{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "dictionaries": [
    "typescript",
    "node",
    "npm",
    "html",
    "css",
    "software-terms",
    "fullstack",
    "companies",
    "fonts",
    "filetypes",
    "public-licenses",
    "git",
    "bash"
  ],
  "files": [
    "src/**/*.{ts,tsx,css,md}",
    "tests/**/*.ts",
    "*.md",
    "*.toml",
    "package.json",
    "config/**/*.{ts,js,json}"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/coverage/**",
    "**/pnpm-lock.yaml",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/*.tsbuildinfo"
  ],
  "words": [
    "Booth",
    "calculatetax",
    "creact",
    "depcruise",
    "Dziedzic",
    "GHSA",
    "ianvs",
    "IETC",
    "KiwiSaver",
    "Lato",
    "lintstaged",
    "lintstagedrc",
    "Lukasz",
    "nosniff",
    "PAYE",
    "perfectionist",
    "sonarjs",
    "tablist",
    "tabpanel",
    "typoland",
    "unicorn"
  ]
}
